# Copia este archivo a .env y completa lo que tengas. Solo SESSION_SECRET es obligatoria.
PORT=8787
# Llave para firmar sesiones (cualquier texto largo y al azar)
SESSION_SECRET=
# Dirección pública del servidor (arma /e/:token y /p/:codigo)
BASE_URL=http://localhost:8787
# Dirección del panel; el enlace personal es PANEL_URL/?t=<sesión>
PANEL_URL=http://localhost:5173
# Origen que CORS deja pasar (si falta, se saca de PANEL_URL)
PANEL_ORIGIN=http://localhost:5173

# Postgres. Sin esto el servidor usa memoria y la semilla.
DATABASE_URL=

# WhatsApp Cloud API. Sin WA_APP_SECRET el webhook responde 503.
WA_TOKEN=
WA_PHONE_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
# Número del bot, solo dígitos (arma los enlaces wa.me)
WA_NUMERO_BOT=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Copia a Google Sheets
SHEETS_ID=
GOOGLE_SA_JSON=
