{
  "name": "huellitas-bot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/src/index.js",
    "semilla": "tsx --env-file=.env scripts/semilla.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "enlace": "tsx --env-file=.env scripts/enlace.ts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
