# Copiar a .env y cambiar la clave
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_PORT=5434

# Espejo a Google Sheets
DATABASE_URL=postgres://huellitas:cambiar-esta-clave@localhost:5434/huellitas
SHEET_ID=id-de-la-hoja-de-google
# Llave JSON de la cuenta de servicio (la hoja se comparte con su correo como Editor)
GOOGLE_APPLICATION_CREDENTIALS=./credenciales-google.json
