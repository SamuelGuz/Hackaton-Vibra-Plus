# Copiar a .env y llenar. Ver README.md para sacar cada valor.

PUERTO=8787

# Postgres de db/ (misma clave que db/.env)
DATABASE_URL=postgres://huellitas:cambiar-esta-clave@localhost:5434/huellitas

# WhatsApp Cloud API (developers.facebook.com → tu app → WhatsApp → Configuración de la API)
WA_TOKEN=token-de-acceso
WA_PHONE_ID=id-del-numero-de-telefono
# Lo inventas tú; se pega igual en la configuración del webhook de Meta
WA_VERIFY_TOKEN=una-frase-secreta-larga
# Configuración de la app → Básica → Clave secreta de la app
WA_APP_SECRET=clave-secreta-de-la-app
WA_API_VERSION=v21.0

# IA: se usa Gemini y, si falla o se le acaba la cuota, OpenRouter. Basta con una de las dos llaves.
# Gemini (aistudio.google.com → Get API key)
GEMINI_API_KEY=llave-de-gemini
GEMINI_MODEL=gemini-2.5-flash
# OpenRouter (openrouter.ai/keys). El modelo debe aceptar audio e imágenes.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Dónde vive el panel. El bot manda enlaces PANEL_URL/?t=<token> y solo este origen pasa el CORS.
PANEL_URL=http://localhost:5173

# Frente externo (catálogo público, agente de adopciones y campañas). Se prende solo si hay GEMINI_API_KEY.
# Número del bot, para los botones "Escríbenos por WhatsApp" (se aceptan espacios y +)
WA_NUMERO_BOT=573000000000
# Correo de las campañas. Sin RESEND_API_KEY ni SMTP_HOST, las campañas se generan y se ven, pero NO se envían.
CORREO_REMITENTE=Fundación Huellitas <onboarding@resend.dev>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Clave que pide POST /api/publico/campanas/enviar (cabecera X-Campana-Clave). Vacía = nadie puede enviar.
CAMPANAS_CLAVE=

# Semilla: el equipo con sus números de WhatsApp (máximo 5 con el número de prueba de Meta).
# Formato: Nombre:rol:telefono separados por coma. Roles: admin, cuidador, bienestar, adopciones, comunicacion, voluntario
EQUIPO=Don Luis:cuidador:573000000001,Andrés:bienestar:573000000002,Carolina:admin:573000000003,Marcela:adopciones:573000000004
